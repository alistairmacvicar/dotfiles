# Sway config file

# Font for window titles
font pango:JetBrainsMono Nerd Font 16

# Set mod to alt
set $mod Mod1

# Get rid of borders and set focused border color
default_border pixel 2
client.focused #77dd77 #285577 #ffffff #2e9ef4 #285577

# Use Mouse+$mod to drag floating windows
floating_modifier $mod normal

# Prevent focus follows mouse (ick)
focus_follows_mouse no

# Prevent workspace back-and-forth which can cause focus loops
workspace_auto_back_and_forth no

# Use these keys for focus, movement, and resize directions when reaching for
# the arrows is not convenient
set $up k
set $down j
set $left h
set $right l

# Start a terminal
bindsym $mod+Return exec kitty

# Kill focused window
bindsym $mod+Shift+q kill

# Force kill focused window (for stubborn apps like Webex)
bindsym $mod+Shift+x exec swaymsg '[pid="$(swaymsg -t get_tree | jq ".. | select(.focused? == true).pid")"]' kill

# Start rofi (a program launcher)
bindsym $mod+Shift+d exec rofi -show drun -matching fuzzy -theme ~/.config/rofi/theme.rasi -theme-str 'mainbox {children: [ "inputbar", "listview" ];}' -theme-str 'window {location: center; anchor: north; y-offset: -150;}'

# Set the background on startup
output * bg ~/Pictures/backgrounds/cozy_room.png fill

# Configure monitors
# Run 'swaymsg -t get_outputs' to see your output names

# Set monitor outputs
# Home monitors
set $monitor1 DP-3
set $monitor2 HDMI-A-2
# Work monitors Level 3
set $monitor3 DP-1
set $monitor4 DP-2
# Work monitors Level 5
set $monitor5 DP-6
set $monitor6 DP-7

# Monitor configuration:
# Home setup
output $monitor1 mode 1920x1080@360Hz pos 0 0
output $monitor2 mode 3840x2160@100Hz scale 2 pos 1920 0
# Work setup Level 3
output $monitor3 mode 1920x1080@60Hz pos 0 0
output $monitor4 mode 1920x1080@60Hz pos 1920 0
# Work setup Level 5
output $monitor5 mode 1920x1080@60Hz pos 0 0
output $monitor6 mode 1920x1080@60Hz pos 1920 0

# Change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split in horizontal orientation
bindsym $mod+z splith

# Split in vertical orientation
bindsym $mod+v splitv

# Enter fullscreen mode for the focused container
bindsym $mod+Shift+f fullscreen toggle

# Change container layout (stacked, tabbed, toggle split)
# bindsym $mod+s layout stacking
# bindsym $mod+w layout tabbed
# bindsym $mod+e layout toggle split

# Toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Set workspaces to outputs
# terminal browser comms browser
workspace $ws1 output $monitor1 $monitor3 $monitor5
workspace $ws2 output $monitor1 $monitor3 $monitor5
workspace $ws3 output $monitor2 $monitor4 $monitor6
workspace $ws4 output $monitor2 $monitor4 $monitor6

# Assign apps to workspaces
# Note: Native Wayland apps use app_id, XWayland apps use class
assign [class="teams-for-linux"] $ws3
assign [class="Webex"] $ws3

# Send apps to workspaces on startup (conditionally based on monitors)
exec ~/.config/sway/autostart.sh

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload the configuration file
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

# Exit Sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec "~/.local/bin/power-dmenu"

# Resize bindings
bindsym $mod+u resize shrink width 10 px or 10 ppt
bindsym $mod+i resize shrink height 10 px or 10 ppt
bindsym $mod+o resize grow height 10 px or 10 ppt
bindsym $mod+p resize grow width 10 px or 10 ppt

# Start waybar
exec waybar

# XDG autostart .desktop files
exec dex --autostart --environment sway

# Screen locking and idle management
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# System tray applets
exec nm-applet --indicator
exec volumeicon

# Volume control (PulseAudio/PipeWire)
bindsym $mod+F1 exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym $mod+F2 exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym $mod+F3 exec pactl set-default-sink alsa_output.usb-DELL_Dell_Speakerphone_SP3022_0-02.analog-stereo
bindsym $mod+F4 exec pactl set-default-sink alsa_output.usb-HP__Inc_HyperX_Cloud_III_Wireless_0000000000000000-00.analog-stereo
bindsym $mod+Shift+a exec ~/.local/bin/audio-switcher

# Media key bindings
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Screenshot (grim + slurp)
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

# Disable mouse acceleration
exec ~/.local/bin/disable-mouse-accel

# XWayland support
xwayland enable

# Rendering optimizations to prevent screen artifacts
# Set max render time to reduce artifacts during window switches
output * max_render_time 5

# Include additional configs
include /etc/sway/config.d/*
